{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "composite": true,
    "declaration": true,
    "declarationMap": true,

    "paths": {
      "@textile/*": ["./packages/*/"]
    }
  },

  "include": ["packages/**/*", "apps/**/*"],
  "exclude": ["node_modules", "dist"]
}
